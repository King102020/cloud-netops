# Copy to .env and adjust. .env is git-ignored.
# LOCAL-ONLY MODE: these are LocalStack dummy values. Never put real AWS credentials here.

# --- AWS / LocalStack ---
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-south-1
AWS_ENDPOINT_URL=http://localhost:4566
# Free LocalStack account token (https://app.localstack.cloud). Or run `lstk login` instead.
LOCALSTACK_AUTH_TOKEN=

# --- Control API (phase 4) — read by api/ via pydantic-settings ---
CNOPS_ENV=local
CNOPS_LOG_LEVEL=INFO
# real = docker exec into the Containerlab lab; fake = in-memory simulated lab
CNOPS_LAB_MODE=real
# apply = terraform apply on LocalStack; plan = validate each change with a plan; fake = no terraform
CNOPS_TERRAFORM_MODE=plan
# real = DynamoDB on LocalStack; fake = in-memory audit log / idempotency keys
CNOPS_STORE_MODE=fake
CNOPS_AWS_ENDPOINT_URL=http://localhost:4566
CNOPS_AUDIT_TABLE=cnops-local-audit-log
CNOPS_IDEMPOTENCY_TABLE=cnops-local-idempotency

# Local JWT issuer. Generate your own secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
CNOPS_JWT_SECRET=change-me-local-only
CNOPS_JWT_ISSUER=cnops-local
CNOPS_JWT_TTL_SECONDS=3600
# Local demo users "name:password:role,...". Change the passwords for anything you share.
CNOPS_DEV_USERS=viewer:viewer-local:viewer,operator:operator-local:operator,admin:admin-local:admin

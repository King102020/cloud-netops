# Copy to .env and adjust. .env is git-ignored.
# LOCAL-ONLY MODE: these are LocalStack dummy values. Never put real AWS credentials here.

# --- AWS / LocalStack ---
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-south-1
AWS_ENDPOINT_URL=http://localhost:4566

# --- Control API (phase 4) ---
CNOPS_ENV=local
CNOPS_API_HOST=127.0.0.1
CNOPS_API_PORT=8000
CNOPS_LOG_LEVEL=INFO
# Local JWT issuer signing secret (generate your own; this is a placeholder).
CNOPS_JWT_SECRET=change-me-local-only
CNOPS_JWT_ISSUER=cnops-local

# --- DynamoDB tables on LocalStack (phase 3/4) ---
CNOPS_AUDIT_TABLE=cnops-local-audit-log
CNOPS_STATE_TABLE=cnops-local-state

# --- Router management (phase 2/4) ---
CNOPS_LAB_NAME=cnops
CNOPS_ROUTER_SSH_USER=admin
CNOPS_ROUTER_SSH_PASSWORD=change-me-local-only

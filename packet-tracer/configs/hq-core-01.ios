! hq-core-01 — 3650-24PS (add AC-POWER-SUPPLY first) — L3 core, WAN hub, HQ DHCP
! Source: docs/network-design.md §3, §4, §5, §6, §7
! Paste in the CLI tab. Replace CHANGE_ME with a lab password first.
enable
configure terminal
hostname hq-core-01
no ip domain-lookup
ip domain-name cnops.internal
service password-encryption
enable secret CHANGE_ME
username admin privilege 15 secret CHANGE_ME
banner motd ^Authorised access only - Cloud NetOps lab^
ip routing
!
vlan 10
 name USERS
vlan 20
 name SERVERS
vlan 30
 name GUEST
vlan 99
 name MGMT
vlan 999
 name NATIVE-UNUSED
exit
!
interface Loopback0
 description Router ID
 ip address 10.255.255.2 255.255.255.255
!
! ---- Routed transit links ----
interface GigabitEthernet1/0/24
 description TRANSIT to hq-edge-01 Gi0/0/1
 no switchport
 ip address 10.255.0.2 255.255.255.252
 ip ospf network point-to-point
 ip ospf cost 1
 no shutdown
!
interface GigabitEthernet1/0/23
 description WAN to br1-edge-01 Gi0/0/0
 no switchport
 ip address 10.255.0.5 255.255.255.252
 ip ospf network point-to-point
 ip ospf cost 10
 no shutdown
!
interface GigabitEthernet1/0/22
 description WAN to br2-edge-01 Gi0/0/0
 no switchport
 ip address 10.255.0.9 255.255.255.252
 ip ospf network point-to-point
 ip ospf cost 10
 no shutdown
!
! ---- Trunk to the access switch ----
! If "switchport trunk encapsulation dot1q" is rejected, that model only does dot1q: ignore it.
interface GigabitEthernet1/0/1
 description TRUNK to hq-access-01 Gi0/1
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk native vlan 999
 switchport trunk allowed vlan 10,20,30,99
 switchport nonegotiate
 no shutdown
!
interface range GigabitEthernet1/0/2 - 21
 description UNUSED
 switchport mode access
 switchport access vlan 999
 shutdown
!
! ---- Gateways (SVIs) ----
interface Vlan10
 description GW USERS
 ip address 10.10.10.1 255.255.255.0
 no shutdown
!
interface Vlan20
 description GW SERVERS
 ip address 10.10.20.1 255.255.255.0
 ip access-group TO-SERVERS out
 no shutdown
!
interface Vlan30
 description GW GUEST
 ip address 10.10.30.1 255.255.255.0
 ip access-group GUEST-IN in
 no shutdown
!
interface Vlan99
 description GW MGMT
 ip address 10.10.99.1 255.255.255.224
 no shutdown
!
interface Vlan1
 shutdown
!
! ---- OSPF ----
router ospf 1
 router-id 10.255.255.2
 auto-cost reference-bandwidth 10000
 passive-interface default
 no passive-interface GigabitEthernet1/0/22
 no passive-interface GigabitEthernet1/0/23
 no passive-interface GigabitEthernet1/0/24
 network 10.255.255.2 0.0.0.0 area 0
 network 10.255.0.0 0.0.0.15 area 0
 network 10.10.0.0 0.0.255.255 area 0
!
! ---- DHCP (§7) ----
ip dhcp excluded-address 10.10.10.1 10.10.10.99
ip dhcp excluded-address 10.10.10.200 10.10.10.254
ip dhcp excluded-address 10.10.30.1 10.10.30.99
ip dhcp excluded-address 10.10.30.200 10.10.30.254
!
ip dhcp pool HQ-USERS
 network 10.10.10.0 255.255.255.0
 default-router 10.10.10.1
 dns-server 10.10.20.10
 domain-name cnops.internal
!
ip dhcp pool HQ-GUEST
 network 10.10.30.0 255.255.255.0
 default-router 10.10.30.1
 dns-server 198.51.100.10
 domain-name cnops.internal
!
! ---- ACLs (§6) ----
ip access-list extended GUEST-IN
 remark Guests: DHCP to the gateway
 permit udp any eq 68 any eq 67
 remark Guests: nothing internal (all RFC 1918)
 deny ip any 10.0.0.0 0.255.255.255
 deny ip any 172.16.0.0 0.15.255.255
 deny ip any 192.168.0.0 0.0.255.255
 remark Guests: internet only, from the real guest subnet (anti-spoofing)
 permit ip 10.10.30.0 0.0.0.255 any
 remark Default deny
 deny ip any any
!
ip access-list extended TO-SERVERS
 remark Internal DNS
 permit udp 10.0.0.0 0.255.255.255 host 10.10.20.10 eq 53
 permit tcp 10.0.0.0 0.255.255.255 host 10.10.20.10 eq 53
 remark Intranet web from USERS at every site
 permit tcp 10.10.10.0 0.0.0.255 host 10.10.20.10 eq 80
 permit tcp 10.20.10.0 0.0.0.255 host 10.10.20.10 eq 80
 permit tcp 10.30.10.0 0.0.0.255 host 10.10.20.10 eq 80
 permit tcp 10.10.10.0 0.0.0.255 host 10.10.20.10 eq 443
 permit tcp 10.20.10.0 0.0.0.255 host 10.10.20.10 eq 443
 permit tcp 10.30.10.0 0.0.0.255 host 10.10.20.10 eq 443
 remark File shares (SMB) from USERS at every site
 permit tcp 10.10.10.0 0.0.0.255 host 10.10.20.11 eq 445
 permit tcp 10.20.10.0 0.0.0.255 host 10.10.20.11 eq 445
 permit tcp 10.30.10.0 0.0.0.255 host 10.10.20.11 eq 445
 remark Ping for troubleshooting, internal only
 permit icmp 10.0.0.0 0.255.255.255 10.10.20.0 0.0.0.255 echo
 remark Replies to connections and DNS lookups the servers started
 permit tcp any 10.10.20.0 0.0.0.255 established
 permit udp any eq 53 10.10.20.0 0.0.0.255
 remark Admin SSH from MGMT only
 permit tcp 10.10.99.0 0.0.0.31 10.10.20.0 0.0.0.255 eq 22
 permit tcp 10.20.99.0 0.0.0.31 10.10.20.0 0.0.0.255 eq 22
 permit tcp 10.30.99.0 0.0.0.31 10.10.20.0 0.0.0.255 eq 22
 remark Default deny
 deny ip any any
!
ip access-list standard MGMT-VTY
 remark SSH only from the MGMT VLANs
 permit 10.10.99.0 0.0.0.31
 permit 10.20.99.0 0.0.0.31
 permit 10.30.99.0 0.0.0.31
 deny any
!
crypto key generate rsa general-keys modulus 2048
ip ssh version 2
!
line console 0
 logging synchronous
 login local
line vty 0 15
 access-class MGMT-VTY in
 transport input ssh
 login local
end
write memory

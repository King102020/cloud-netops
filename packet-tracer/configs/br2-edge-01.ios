! br2-edge-01 — ISR4331 — branch router, OSPF ABR (area 2), br2 DHCP
! Source: docs/network-design.md §3, §4, §5, §6, §7
! Paste in the CLI tab. Replace CHANGE_ME with a lab password first.
enable
configure terminal
hostname br2-edge-01
no ip domain-lookup
ip domain-name cnops.internal
service password-encryption
enable secret CHANGE_ME
username admin privilege 15 secret CHANGE_ME
banner motd ^Authorised access only - Cloud NetOps lab^
!
interface Loopback0
 description Router ID
 ip address 10.255.255.4 255.255.255.255
!
interface GigabitEthernet0/0/0
 description WAN to hq-core-01 Gi1/0/22
 ip address 10.255.0.10 255.255.255.252
 ip ospf network point-to-point
 ip ospf cost 10
 no shutdown
!
interface GigabitEthernet0/0/1
 description BACKUP to br1-edge-01 Gi0/0/1
 ip address 10.255.0.14 255.255.255.252
 ip ospf network point-to-point
 ip ospf cost 100
 no shutdown
!
! ---- Router-on-a-stick to br2-access-01 ----
interface GigabitEthernet0/0/2
 description TRUNK to br2-access-01 Gi0/1
 no ip address
 no shutdown
!
interface GigabitEthernet0/0/2.10
 description GW USERS
 encapsulation dot1Q 10
 ip address 10.30.10.1 255.255.255.0
!
interface GigabitEthernet0/0/2.30
 description GW GUEST
 encapsulation dot1Q 30
 ip address 10.30.30.1 255.255.255.0
 ip access-group GUEST-IN in
!
interface GigabitEthernet0/0/2.99
 description GW MGMT
 encapsulation dot1Q 99
 ip address 10.30.99.1 255.255.255.224
!
interface GigabitEthernet0/0/2.999
 description NATIVE-UNUSED
 encapsulation dot1Q 999 native
!
! ---- OSPF: ABR between area 0 (WAN) and area 2 (br2 LANs) ----
router ospf 1
 router-id 10.255.255.4
 auto-cost reference-bandwidth 10000
 passive-interface default
 no passive-interface GigabitEthernet0/0/0
 no passive-interface GigabitEthernet0/0/1
 network 10.255.255.4 0.0.0.0 area 0
 network 10.255.0.8 0.0.0.3 area 0
 network 10.255.0.12 0.0.0.3 area 0
 network 10.30.0.0 0.0.255.255 area 2
 area 2 range 10.30.0.0 255.255.0.0
!
! ---- DHCP (§7) ----
ip dhcp excluded-address 10.30.10.1 10.30.10.99
ip dhcp excluded-address 10.30.10.200 10.30.10.254
ip dhcp excluded-address 10.30.30.1 10.30.30.99
ip dhcp excluded-address 10.30.30.200 10.30.30.254
!
ip dhcp pool BR2-USERS
 network 10.30.10.0 255.255.255.0
 default-router 10.30.10.1
 dns-server 10.10.20.10
 domain-name cnops.internal
!
ip dhcp pool BR2-GUEST
 network 10.30.30.0 255.255.255.0
 default-router 10.30.30.1
 dns-server 198.51.100.10
 domain-name cnops.internal
!
! ---- ACLs (§6) ----
ip access-list extended GUEST-IN
 remark Guests: DHCP to the gateway
 permit udp any eq 68 any eq 67
 remark Guests: nothing internal (all RFC 1918)
 deny ip any 10.0.0.0 0.255.255.255
 deny ip any 172.16.0.0 0.15.255.255
 deny ip any 192.168.0.0 0.0.255.255
 remark Guests: internet only, from the real guest subnet (anti-spoofing)
 permit ip 10.30.30.0 0.0.0.255 any
 remark Default deny
 deny ip any any
!
ip access-list standard MGMT-VTY
 remark SSH only from the MGMT VLANs
 permit 10.10.99.0 0.0.0.31
 permit 10.20.99.0 0.0.0.31
 permit 10.30.99.0 0.0.0.31
 deny any
!
crypto key generate rsa general-keys modulus 2048
ip ssh version 2
!
line console 0
 logging synchronous
 login local
line vty 0 15
 access-class MGMT-VTY in
 transport input ssh
 login local
end
write memory

! br1-access-01 — 2960-24TT — br1 access switch
! Source: docs/network-design.md §3, §4.4
! Paste in the CLI tab. Replace CHANGE_ME with a lab password first.
enable
configure terminal
hostname br1-access-01
no ip domain-lookup
ip domain-name cnops.internal
service password-encryption
enable secret CHANGE_ME
username admin privilege 15 secret CHANGE_ME
banner motd ^Authorised access only - Cloud NetOps lab^
!
vlan 10
 name USERS
vlan 30
 name GUEST
vlan 99
 name MGMT
vlan 999
 name NATIVE-UNUSED
exit
!
interface range FastEthernet0/1 - 10
 description USERS
 switchport mode access
 switchport access vlan 10
 spanning-tree portfast
 spanning-tree bpduguard enable
 no shutdown
!
interface range FastEthernet0/16 - 20
 description GUEST
 switchport mode access
 switchport access vlan 30
 spanning-tree portfast
 spanning-tree bpduguard enable
 no shutdown
!
interface range FastEthernet0/11 - 15 , FastEthernet0/21 - 24 , GigabitEthernet0/2
 description UNUSED
 switchport mode access
 switchport access vlan 999
 shutdown
!
interface GigabitEthernet0/1
 description TRUNK to br1-edge-01 Gi0/0/2
 switchport mode trunk
 switchport trunk native vlan 999
 switchport trunk allowed vlan 10,30,99
 switchport nonegotiate
 no shutdown
!
interface Vlan99
 description MGMT
 ip address 10.20.99.2 255.255.255.224
 no shutdown
interface Vlan1
 shutdown
ip default-gateway 10.20.99.1
!
ip access-list standard MGMT-VTY
 remark SSH only from the MGMT VLANs
 permit 10.10.99.0 0.0.0.31
 permit 10.20.99.0 0.0.0.31
 permit 10.30.99.0 0.0.0.31
 deny any log
!
crypto key generate rsa general-keys modulus 2048
ip ssh version 2
!
line console 0
 logging synchronous
 login local
line vty 0 15
 access-class MGMT-VTY in
 transport input ssh
 login local
end
write memory
